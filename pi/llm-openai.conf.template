# nginx template, rendered by the official nginx image's envsubst entrypoint.
# Sits between pi and the OpenAI API:
#   - checks the caller's bearer token (OPENAI_CALLER_TOKEN),
#   - replaces it with the real API key (OPENAI_API_KEY), which pi never sees,
#   - forwards to api.openai.com with TLS certificate verification.
# Only variables defined in the environment are substituted; nginx's own
# variables ($http_authorization) are left untouched.
server {
    listen 8080;

    location /v1/ {
        if ($http_authorization != "Bearer ${OPENAI_CALLER_TOKEN}") {
            return 401;
        }

        proxy_pass https://api.openai.com/v1/;
        proxy_set_header Authorization "Bearer ${OPENAI_API_KEY}";
        proxy_set_header Host api.openai.com;
        # Drop client-chosen org/project headers: the key decides.
        proxy_set_header OpenAI-Organization "";
        proxy_set_header OpenAI-Project "";

        proxy_ssl_server_name on;
        proxy_ssl_name api.openai.com;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Streaming responses, long generations, image attachments.
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 600s;
        client_max_body_size 50m;
    }

    location / { return 404; }
}
