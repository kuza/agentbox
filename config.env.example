# agentbox settings. Copy to config.env and adjust:
#   cp config.env.example config.env
# Format: KEY=VALUE, one per line, # starts a comment, quotes are optional.
# The file is parsed, not executed. Environment variables override it.

# Optional services: each one is enabled by its base URL (without /api or
# /mcp) and needs its Podman secret (README, step 5). Leave out what you do
# not use.
#GRAFANA_URL=https://grafana.example.internal
#GRAYLOG_URL=https://graylog.example.internal

# Optional.
#GH_TOOLSETS=context,repos,issues,pull_requests,actions
#AB_SKILLS_DIR=/path/to/skills
# Seconds between agent updates and between update checks (images, skills).
#AB_UPDATE_EVERY=21600
# 0: no check for newer sidecar images and vendored skills before a session.
#AB_CHECK_UPDATES=1
# graphify extras baked into the image, e.g. [terraform] for .tf/.hcl or
# [sql,terraform]; takes effect on the next build: AB_UPGRADE=1 ./run.sh
#AB_GRAPHIFY_EXTRAS=[terraform]
# Your dev containers the agent may reach by name (redis:6379), see README.
#AB_SERVICES=redis rabbitmq postgres
# Per-project environment files, <repo dir name>.env, see README.
#AB_ENV_DIR=/path/to/env
