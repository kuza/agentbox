#!/usr/bin/env bash
# agentbox: the command install.sh puts in ~/.local/bin (a link to the
# current installed version). Also works from a clone.
#
#   agentbox [repo-dir] [agent args...]   Claude Code in the box (run.sh)
#   agentbox pi [repo-dir] [args...]      pi
#   agentbox shell [repo-dir] [args...]   bash in the box instead of an agent
#   agentbox login                        a Claude Code token (browser sign-in),
#                                         stored as the claude_oauth secret
#   agentbox version                      this version
#   agentbox update [--yes]               the newest signed release, after
#                                         showing its changes
#   agentbox rollback                     back to the version before
#   agentbox setup                        a menu to edit config.env: MCP
#                                         modules, skills, egress, settings
#                                         (lib/setup.sh)
#   agentbox uninstall [--yes] [--all]    remove agentbox from this host
#                                         (lib/uninstall.sh)
#
# The words above are commands; a repository directory with such a name is
# opened as ./pi, ./update and so on.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/release.sh
source "$SCRIPT_DIR/lib/release.sh"

# Tab completion and the environment.d file: an update from an older
# version did not make them. Not before an uninstall, which removes them.
if release_installed && [[ "${1:-}" != uninstall ]]; then
  release_sync_completion 2>/dev/null || true
  release_sync_environment || true
fi

case "${1:-}" in
  pi)       shift; exec env AB_AGENT=pi "$SCRIPT_DIR/run.sh" "$@" ;;
  shell)    shift; exec env AB_AGENT=shell "$SCRIPT_DIR/run.sh" "$@" ;;
  login)    shift; exec env AB_LOGIN=1 "$SCRIPT_DIR/run.sh" "$@" ;;
  version)  agentbox_version ;;
  update)   shift; release_update "$@" ;;
  rollback) release_rollback ;;
  setup)
    shift
    # shellcheck source=lib/paths.sh
    source "$SCRIPT_DIR/lib/paths.sh"
    # shellcheck source=lib/config.sh
    source "$SCRIPT_DIR/lib/config.sh"
    for lib in sidecars mcp egress skills setup; do
      # shellcheck source=/dev/null
      source "$SCRIPT_DIR/lib/$lib.sh"
    done
    agentbox_setup "$@" ;;
  uninstall)
    shift
    # shellcheck source=lib/paths.sh
    source "$SCRIPT_DIR/lib/paths.sh"
    # shellcheck source=lib/config.sh
    source "$SCRIPT_DIR/lib/config.sh"
    # shellcheck source=lib/sidecars.sh
    source "$SCRIPT_DIR/lib/sidecars.sh"
    # shellcheck source=lib/uninstall.sh
    source "$SCRIPT_DIR/lib/uninstall.sh"
    agentbox_uninstall "$@" ;;
  *)        exec "$SCRIPT_DIR/run.sh" "$@" ;;
esac
