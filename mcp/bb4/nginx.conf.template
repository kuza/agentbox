# nginx template for ab-mcp-bb4, rendered by the official nginx image's
# envsubst entrypoint. Only variables defined in the environment are
# substituted:
#   BB4_CALLER_TOKEN  the caller token the agent sends, from the podman
#                     secret bb4_mcp_caller (created by run.sh)
#   BB4_BRIDGE_KEY    supergateway's key in ab-mcp-bb4-devtools, from the
#                     podman secret bb4_bridge_key (created by mcp/bb4)
# nginx's own variables ($http_authorization) are left untouched.
server {
    listen 8080;

    location = /mcp {
        if ($http_authorization != "Bearer ${BB4_CALLER_TOKEN}") {
            return 401;
        }
        proxy_pass http://ab-mcp-bb4-devtools:8000/mcp;
        proxy_set_header Authorization "Bearer ${BB4_BRIDGE_KEY}";
        proxy_set_header X-API-Key "";
        proxy_set_header Host 127.0.0.1;

        # Streamable HTTP: no buffering, allow long-running responses (a page
        # that loads slowly, a trace).
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / { return 404; }
}
