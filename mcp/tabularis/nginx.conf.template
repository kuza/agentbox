# nginx template, rendered by the official nginx image's envsubst entrypoint.
# Only variables defined in the environment are substituted:
#   TABULARIS_CALLER_TOKEN  the caller token the agent sends, from the podman
#                           secret tabularis_mcp_caller (created by run.sh)
#   TABULARIS_BRIDGE_KEY    supergateway's key, from the podman secret
#                           tabularis_bridge_key (created by mcp/tabularis)
# nginx's own variables ($http_authorization) are left untouched.
server {
    listen 8080;

    location = /mcp {
        if ($http_authorization != "Bearer ${TABULARIS_CALLER_TOKEN}") {
            return 401;
        }
        # The relay's socket, forwarded to supergateway on the host.
        proxy_pass http://unix:/run/tabularis/mcp.sock:/mcp;
        proxy_set_header Authorization "Bearer ${TABULARIS_BRIDGE_KEY}";
        proxy_set_header X-API-Key "";
        proxy_set_header Host 127.0.0.1;

        # Streamable HTTP: no buffering, allow long-running responses. A
        # write waits for approval in the Tabularis window, 120 s by default.
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / { return 404; }
}
