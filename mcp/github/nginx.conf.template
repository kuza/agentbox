# nginx template, rendered by the official nginx image's envsubst entrypoint.
# Sits between Claude and github-mcp-server:
#   - checks the caller's bearer token (GH_CALLER_TOKEN),
#   - replaces it with the GitHub PAT (GH_PAT), which Claude never sees,
#   - pins server behaviour headers so the client cannot change them.
# Only variables defined in the environment are substituted; nginx's own
# variables ($http_authorization, $proxy_host) are left untouched.
server {
    listen 8080;

    location = /mcp {
        if ($http_authorization != "Bearer ${GH_CALLER_TOKEN}") {
            return 401;
        }

        # Fixed upstream path: the client cannot reach /readonly or /x/<toolset>.
        proxy_pass http://ab-mcp-github-srv:8082/;
        proxy_set_header Authorization "Bearer ${GH_PAT}";
        proxy_set_header Host $proxy_host;

        # Server behaviour, enforced here. An empty value removes the header,
        # so client-supplied overrides are dropped.
        proxy_set_header X-MCP-Toolsets "${GH_TOOLSETS}";
        proxy_set_header X-MCP-Lockdown "true";
        proxy_set_header X-MCP-Readonly "";
        proxy_set_header X-MCP-Tools "";
        proxy_set_header X-MCP-Insiders "";

        # Streamable HTTP: no buffering, allow long-running responses.
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / { return 404; }
}
