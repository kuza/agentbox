#!/usr/bin/env bash
# Stand-in for podman in the tests. Every call is appended to $STUB_DIR/calls,
# one line per call. State lives in files under $STUB_DIR, which the tests
# prepare and inspect:
#   secrets       podman secrets that exist, one name per line
#   running       running containers: "<name> <image>" per line
#   labels        "<container> <key>=<value>" per line
#   digests       "<image> <digest>" per line: local RepoDigests
#   image_ids     "<image> <id>" per line; missing images get "id-<image>"
#   container_images  "<container> <image id>" per line; default: image's id
# Environment:
#   STUB_IMAGE_ID   ID of localhost/agentbox (default: img-1)
#   STUB_BUILT_ID   a build gives localhost/agentbox this ID
#   STUB_RUN_FAIL   a container name: run -d of it fails with an Error: line
#   STUB_PULL_FAIL  any value: every pull fails
#   STUB_PULL_NEW   images (space-separated) a pull replaces: ID new-<image>
#   STUB_RMI_FAIL   image IDs rmi refuses to remove (still in use)
#   STUB_NO_SOCAT   the agentbox image has no socat: run -d with it fails
#   STUB_NO_TRIVY   the agentbox image has no trivy
#   STUB_NETWORKS   networks a service container is on (default: podman ab-services)
# For uninstall: volumes, networks ("<name>" per line) and netconns
# ("<network> <container>" per line) list what exists.
#   image_labels  "<image> <agentbox.build fingerprint>" per line, written by
#                 build; an image without a line counts as current
#   image_pulled  "<image> <agentbox.pulled>" per line, written by build
#   old_squid     exists: docker.io/ubuntu/squid:latest is there (else not)
#   volumes_absent  volumes that do not exist, one per line (others do)
#   STUB_OLD_PODMAN podman before 4.7: secret create has no --replace
#   STUB_SECRET_LS_FAIL  secret ls fails (a locked database, say)
#   STUB_SECRET_CREATE_FAIL  secret create fails
#   STUB_HIDDEN_FILE  agent_prepare_home's script finds that file hidden
#   STUB_GRAPHIFY   ok: `graphify install` writes the skill files; else nothing
#   STUB_SESSION_RC the session container (run --rm --name ab-...) prints STUB-SESSION-END and exits with this status
set -u
S="${STUB_DIR:?}"
touch "$S/secrets" "$S/running" "$S/labels" "$S/image_labels" "$S/image_pulled" "$S/digests" "$S/image_ids" "$S/container_images" "$S/ids" \
      "$S/volumes" "$S/networks" "$S/netconns"
drop() {  # <file> <first field>: remove its lines
  awk -v x="$2" '$1 != x' "$S/$1" > "$S/$1.new"; mv "$S/$1.new" "$S/$1"
}
# Its own calls for one field of a |-joined inspect are not podman calls.
[[ -n "${STUB_SELF:-}" ]] || printf '%s\n' "podman $*" >> "$S/calls"

image_id() {  # <image>
  local id
  if [[ "$1" == localhost/agentbox ]]; then
    [[ -f "$S/agentbox_id" ]] && { cat "$S/agentbox_id"; return; }
    echo "${STUB_IMAGE_ID:-img-1}"; return
  fi
  id="$(awk -v i="$1" '$1 == i { print $2 }' "$S/image_ids")"
  echo "${id:-id-$1}"
}

case "$1 ${2:-}" in
  "secret inspect")
    grep -qx -- "$3" "$S/secrets" || exit 1
    # --format '{{.ID}}': an ID that changes with the secret's value.
    [[ " $* " == *" --format "* ]] && echo "id-$({ cksum < "$S/secret-$3"; } 2>/dev/null | cut -d' ' -f1)"
    exit 0 ;;
  "secret rm") drop secrets "$3" ;;
  "secret ls")
    [[ -n "${STUB_SECRET_LS_FAIL:-}" ]] && { echo "Error: database is locked" >&2; exit 125; }
    # --format '{{.Name}} {{.ID}}': an ID as secret inspect gives it.
    if [[ " $* " == *"{{.ID}}"* ]]; then
      while read -r n; do echo "$n id-$({ cksum < "$S/secret-$n"; } 2>/dev/null | cut -d' ' -f1)"; done < "$S/secrets"
    else
      cat "$S/secrets"
    fi ;;
  "volume ls") cat "$S/volumes" ;;
  "volume rm") drop volumes "$3" ;;
  "network ls") cat "$S/networks" ;;
  "network inspect")
    # --format '{{.Internal}}': STUB_NET_INTERNAL, default true.
    [[ " $* " == *"{{.Internal}}"* ]] && { echo "${STUB_NET_INTERNAL:-true}"; exit 0; }
    awk -v n="$3" '$1 == n { printf "%s ", $2 }' "$S/netconns" ;;
  "network disconnect") awk -v n="$3" -v c="$4" '!($1 == n && $2 == c)' "$S/netconns" > "$S/nc.new"; mv "$S/nc.new" "$S/netconns" ;;
  "network rm")
    if [[ "$3" != -f ]] && awk -v n="$3" '$1 == n { f = 1 } END { exit !f }' "$S/netconns"; then
      echo "Error: network $3 is in use" >&2; exit 2
    fi
    drop networks "${*: -1}" ;;
  "secret create")
    if [[ " $* " == *" --help "* ]]; then
      [[ -n "${STUB_OLD_PODMAN:-}" ]] && echo "  -d, --driver string" || echo "      --replace   replace the secret"
      exit 0
    fi
    if [[ -n "${STUB_OLD_PODMAN:-}" && " $* " == *" --replace "* ]]; then echo "Error: unknown flag: --replace" >&2; exit 125; fi
    if [[ " $* " != *" --replace "* ]] && grep -qx -- "${*: -2:1}" "$S/secrets"; then
      echo "Error: ${*: -2:1}: secret name in use" >&2; exit 125
    fi
    # secret create [--replace] <name> -: the value goes to secret-<name>.
    [[ -n "${STUB_SECRET_CREATE_FAIL:-}" ]] && { echo "Error: database is locked" >&2; exit 125; }
    name=""; for a in "${@:3}"; do [[ "$a" == -* ]] || { name="$a"; break; }; done
    cat > "$S/secret-$name"
    grep -qx -- "$name" "$S/secrets" || echo "$name" >> "$S/secrets"
    # Like podman, the new secret's ID, as secret inspect gives it.
    echo "id-$(cksum < "$S/secret-$name" | cut -d' ' -f1)" ;;
  "image exists")
    [[ "$3" == docker.io/ubuntu/squid:latest ]] && { [[ -f "$S/old_squid" ]]; exit; }
    exit 0 ;;
  "volume exists") ! grep -qx -- "$3" "$S/volumes_absent" 2>/dev/null ;;
  "network exists"|"container exists") exit 0 ;;
  "network create"|"network connect"|"start "*) exit 0 ;;
  "build "*)
    tag=""; fp=""; prev=""; pulled=""
    for a in "$@"; do
      [[ "$prev" == -t ]] && tag="$a"
      [[ "$prev" == --label && "$a" == agentbox.build=* ]] && fp="${a#agentbox.build=}"
      [[ "$prev" == --label && "$a" == agentbox.pulled=* ]] && pulled="${a#agentbox.pulled=}"
      prev="$a"
    done
    drop image_labels "$tag"; echo "$tag $fp" >> "$S/image_labels"
    drop image_pulled "$tag"; [[ -n "$pulled" ]] && echo "$tag $pulled" >> "$S/image_pulled"
    [[ -n "${STUB_BUILT_ID:-}" && "$tag" == localhost/agentbox ]] && echo "$STUB_BUILT_ID" > "$S/agentbox_id"
    exit 0 ;;
  "images -q")
    # images -q --filter reference=<image> --filter label=agentbox.build=<fp>
    ref=""; want=""
    for a in "$@"; do
      case "$a" in reference=*) ref="${a#reference=}" ;; label=agentbox.build=*) want="${a#label=agentbox.build=}" ;; esac
    done
    have="$(awk -v i="$ref" '$1 == i { print $2 }' "$S/image_labels")"
    if ! grep -q "^$ref " "$S/image_labels" || [[ "$have" == "$want" ]]; then image_id "$ref"; fi ;;
  "images --filter")
    # images --filter label=agentbox.build --format '{{.Repository}}[:{{.Tag}}]':
    # the images built here
    [[ "$*" == *"label=agentbox.build "* ]] || exit 0
    awk '{ print $1 }' "$S/image_labels" ;;
  "pull -q")
    [[ -z "${STUB_PULL_FAIL:-}" ]] || exit 1
    if [[ " ${STUB_PULL_NEW:-} " == *" $3 "* ]]; then
      grep -v "^$3 " "$S/image_ids" > "$S/image_ids.new"; mv "$S/image_ids.new" "$S/image_ids"
      echo "$3 new-$3" >> "$S/image_ids"
    fi ;;
  "rmi "*)
    [[ " ${STUB_RMI_FAIL:-} " != *" $2 "* ]] || exit 1
    [[ "$2" == docker.io/ubuntu/squid:latest || "$2" == id-docker.io/ubuntu/squid:latest ]] && rm -f "$S/old_squid"
    exit 0 ;;
  "image inspect")
    case "$*" in
      *agentbox.pulled*) awk -v i="${*: -1}" '$1 == i { print $2 }' "$S/image_pulled" 2>/dev/null ;;
      *Created.Unix*) [[ -n "${STUB_IMAGE_CREATED:-}" ]] && echo "$STUB_IMAGE_CREATED" || echo x ;;
      *RepoDigests*) awk -v i="${*: -1}" '$1 == i { print "x@" $2 }' "$S/digests" ;;
      *) image_id "${*: -1}" ;;
    esac ;;
  "inspect -f"|"inspect --format")
    name="${*: -1}"
    # Several fields joined by |: each as asked alone.
    if [[ "$3" == *"}}|{{"* ]]; then
      out=""; rest="$3"
      while [[ -n "$rest" ]]; do
        f="${rest%%|\{\{*}"; [[ "$f" == "$rest" ]] && rest="" || rest="${rest#"$f"|}"
        out+="${out:+|}$(STUB_SELF=1 "$0" inspect -f "$f" "$name")"
      done
      echo "$out"; exit 0
    fi
    case "$3" in
      *State.Running*) grep -q "^$name " "$S/running" && echo true || echo false ;;
      *Labels*) key="$(sed -n 's/.*"\([^"]*\)".*/\1/p' <<<"$3")"
                awk -v n="$name" -v k="$key" '$1 == n { split($2, a, "="); if (a[1] == k) print a[2] }' "$S/labels" ;;
      *NetworkMode*) echo bridge ;;
      *ImageName*) awk -v n="$name" '$1 == n { print $2 }' "$S/running" ;;
      *Networks*) echo "${STUB_NETWORKS:-podman ab-services}" ;;
      *'{{.Id}}'*) awk -v n="$name" '$1 == n { print $2 }' "$S/ids" ;;
      *'{{.Image}}'*) id="$(awk -v n="$name" '$1 == n { print $2 }' "$S/container_images")"
                      if [[ -z "$id" ]]; then
                        img="$(awk -v n="$name" '$1 == n { print $2 }' "$S/running")"
                        id="$(image_id "$img")"
                      fi
                      echo "$id" ;;
      *) echo x ;;
    esac ;;
  "ps -a")
    # --filter label=<key>=<value>: only containers with that label.
    filter=""; all="$*"
    while (( $# )); do [[ "$1" == --filter ]] && filter="${2#label=}"; shift; done
    if [[ -n "$filter" ]]; then
      awk -v f="$filter" '$2 == f { print $1 }' "$S/labels" | sort -u
    elif [[ "$all" == *agentbox.module* ]]; then
      # --format '{{.Names}} {{index .Labels "agentbox.module"}}'
      while read -r n _; do
        m="$(awk -v n="$n" '$1 == n && $2 ~ /^agentbox.module=/ { sub(/^agentbox.module=/, "", $2); m = $2 } END { print m }' "$S/labels")"
        echo "$n $m"
      done < "$S/running"
    else
      cat "$S/running"
    fi ;;
  "rm -f")
    shift 2
    for n in "$@"; do
      grep -v "^$n " "$S/running" > "$S/running.new"; mv "$S/running.new" "$S/running"
      grep -v "^$n " "$S/labels" > "$S/labels.new"; mv "$S/labels.new" "$S/labels"
    done ;;
  "run -d")
    [[ -n "${STUB_RUN_FAIL:-}" && "$*" == *"--name $STUB_RUN_FAIL "* ]] \
      && { echo "${STUB_RUN_ERR:-Error: stub: cannot start $STUB_RUN_FAIL}" >&2; exit 125; }
    [[ "$*" == *--entrypoint=socat* && -n "${STUB_NO_SOCAT:-}" ]] && { echo "executable file \`socat\` not found" >&2; exit 127; }
    # run -d --replace --name <name> [options] <image> [args]: the image is the
    # first argument after the options that does not start with "-" and is not
    # an option's value.
    shift 2
    name=""; image=""
    while (( $# )); do
      case "$1" in
        --replace) shift ;;
        --name) name="$2"; shift 2 ;;
        --label) echo "$name $2" >> "$S/labels"; shift 2 ;;
        --network|-e|-v|--secret) shift 2 ;;
        -*) shift ;;
        *) image="$1"; break ;;
      esac
    done
    grep -v "^$name " "$S/running" > "$S/running.new"; mv "$S/running.new" "$S/running"
    echo "$name $image" >> "$S/running"
    # A new container ID on every run.
    grep -v "^$name " "$S/ids" > "$S/ids.new"; mv "$S/ids.new" "$S/ids"
    # The container keeps the image it started on, whatever its tag names later.
    drop container_images "$name"; echo "$name $(image_id "$image")" >> "$S/container_images"
    seq=$(( $(cat "$S/idseq" 2>/dev/null || echo 0) + 1 )); echo "$seq" > "$S/idseq"
    echo "$name $name-$seq" >> "$S/ids" ;;
  "run --rm")
    if [[ -n "${STUB_SESSION_RC:-}" && " $* " == *" --name ab-"* ]]; then
      printf 'STUB-SESSION-END'
      exit "$STUB_SESSION_RC"
    fi
    # agent_prepare_home's script reports a hidden file of yours.
    if [[ -n "${STUB_HIDDEN_FILE:-}" && " $* " == *" AB_COVERED="* ]]; then
      echo "warning: ~/$STUB_HIDDEN_FILE in the volume is hidden"
    fi
    # A python3 program in the image (mcp/dbhub): runs here, from -I on.
    if [[ " $* " == *" --entrypoint python3 "* ]]; then
      while (( $# )) && [[ "$1" != -I ]]; do shift; done
      exec python3 "$@"
    fi
    if [[ -n "${STUB_NO_TRIVY:-}" && ( "$*" == *"--entrypoint trivy"* || "$*" == *"command -v trivy"* ) ]]; then exit 1; fi
    if [[ "$*" == *"graphify install"* && "${STUB_GRAPHIFY:-}" == ok ]]; then
      out="$(printf '%s\n' "$@" | sed -n 's#^\(.*\):/out:z$#\1#p')"
      for d in .claude/skills/graphify .pi/agent/skills/graphify; do
        mkdir -p "$out/$d/references"
        printf -- '---\nname: graphify\n---\n' > "$out/$d/SKILL.md"
        echo 0.0.1 > "$out/$d/.graphify_version"
      done
    fi
    exit 0 ;;
  *) exit 0 ;;
esac
